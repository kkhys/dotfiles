{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "cleanupPeriodDays": 180,
  "env": {
    "CLAUDE_CODE_ENABLE_TELEMETRY": "0",
    "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "1"
  },
  "attribution": {
    "commit": "Co-Authored-By: Claude <noreply@anthropic.com>",
    "pr": ""
  },
  "permissions": {
    "allow": [
      "Bash",
      "Read",
      "Edit",
      "Write",
      "WebFetch",
      "WebSearch",
      "mcp__plugin_mcp_context7__*",
      "mcp__plugin_mcp_serena__*",
      "mcp__plugin_mcp_playwright__*",
      "mcp__plugin_mcp_chrome-devtools__*",
      "mcp__plugin_mcp_astro-docs__*",
      "mcp__plugin_mcp_analytics-mcp__*",
      "Skill(base:*)",
      "Skill(pr-review-toolkit:*)",
      "Skill(codex:*)",
      "Skill(skill-creator:*)",
      "Skill(modern-web-guidance:*)"
    ],
    "deny": [
      "mcp__plugin_mcp_serena__execute_shell_command",
      "Bash(rm* -rf*)",
      "Bash(chmod* 777*)",
      "Bash(dd:*)",
      "Bash(gh* repo delete*)",
      "Bash(gh auth logout:*)",
      "Bash(gh* secret delete*)",
      "Bash(gh* variable delete*)",
      "Bash(aws* s3 rm*)",
      "Bash(aws* s3 rb*)",
      "Bash(aws* ec2 terminate-instances*)",
      "Bash(aws* rds delete-db-instance*)",
      "Bash(aws* rds delete-db-cluster*)",
      "Bash(aws* lambda delete-function*)",
      "Bash(aws* iam delete-*)",
      "Bash(aws* cloudformation delete-stack*)",
      "Bash(aws* dynamodb delete-table*)",
      "Bash(aws* sns delete-topic*)",
      "Bash(aws* sqs delete-queue*)",
      "Bash(terraform* state push*)",
      "Bash(terraform* apply*)",
      "Bash(terragrunt* apply*)",
      "Bash(just* apply*)",
      "Read(.env)",
      "Read(.env.*)",
      "Read(.envrc)",
      "Read(~/.aws/**)",
      "Read(~/.ssh/id_*)",
      "Read(~/.gnupg/**)",
      "Read(./secrets/**)",
      "Read(/run/agenix/**)",
      "Read(**/credentials.json)",
      "Edit(.env*)",
      "Edit(~/.ssh/**)",
      "Edit(~/.aws/**)",
      "Bash(terraform* destroy*)",
      "Bash(terragrunt* destroy*)",
      "Bash(terraform* state rm*)",
      "Bash(brew* install*)",
      "Bash(brew* uninstall*)",
      "Bash(brew* bundle*)",
      "Read(**/*.token)",
      "Read(**/.*token*)",
      "Bash(rm* -fr*)",
      "Bash(rm* -r -f*)",
      "Bash(rm* -f -r*)",
      "Bash(rm* --recursive*)"
    ],
    "ask": [
      "Bash(git push:*)",
      "Bash(git rebase:*)",
      "Bash(git* reset*)",
      "Bash(gh pr create:*)",
      "Bash(gh issue create:*)",
      "Bash(gh release create:*)",
      "Bash(aws s3 cp:*)",
      "Bash(aws s3 sync:*)",
      "Bash(aws* s3 mv*)",
      "Bash(aws ec2 run-instances:*)",
      "Bash(aws ec2 start-instances:*)",
      "Bash(aws ec2 stop-instances:*)",
      "Bash(aws lambda create-function:*)",
      "Bash(aws lambda update-function-code:*)",
      "Bash(aws cloudformation create-stack:*)",
      "Bash(aws cloudformation update-stack:*)",
      "Bash(sudo:*)",
      "Bash(npm uninstall:*)",
      "Bash(npm remove:*)",
      "Bash(git* clean*)",
      "Bash(docker* system prune*)",
      "Bash(kubectl* delete*)",
      "Bash(gh* pr merge*)",
      "Bash(gh gist create:*)",
      "Bash(gh workflow run:*)",
      "Bash(npm* publish*)",
      "Bash(pnpm* publish*)",
      "Bash(cargo* publish*)"
    ]
  },
  "model": "fable[1m]",
  "disableClaudeAiConnectors": true,
  "statusLine": {
    "type": "command",
    "command": "bash ~/.claude/statusline-command.sh",
    "padding": 0,
    "refreshInterval": 30
  },
  "enabledPlugins": {
    "base@my-marketplace": true,
    "mcp@my-marketplace": true,
    "codex@openai-codex": true,
    "security-guidance@claude-plugins-official": true,
    "pr-review-toolkit@claude-plugins-official": true,
    "skill-creator@claude-plugins-official": true,
    "modern-web-guidance@googlechrome": true
  },
  "extraKnownMarketplaces": {
    "my-marketplace": {
      "source": {
        "source": "github",
        "repo": "kkhys/claude-code-marketplace"
      },
      "autoUpdate": true
    },
    "claude-plugins-official": {
      "source": {
        "source": "github",
        "repo": "anthropics/claude-plugins-official"
      },
      "autoUpdate": true
    },
    "openai-codex": {
      "source": {
        "source": "github",
        "repo": "openai/codex-plugin-cc"
      },
      "autoUpdate": true
    },
    "googlechrome": {
      "source": {
        "source": "github",
        "repo": "GoogleChrome/modern-web-guidance"
      },
      "autoUpdate": true
    }
  },
  "outputStyle": "base:terse-japanese",
  "language": "japanese",
  "effortLevel": "xhigh",
  "promptSuggestionEnabled": false,
  "emojiCompletionEnabled": false,
  "tui": "fullscreen",
  "autoMemoryEnabled": false,
  "theme": "dark",
  "agentPushNotifEnabled": true,
  "voiceEnabled": true
}
