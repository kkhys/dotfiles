{
  "permissions": {
    "allow": [
      "exec",
      "Write(/**)",
      "Fetch(domain:*)",
      "mcp__context7__*",
      "mcp__serena__*",
      "mcp__playwright__*",
      "mcp__chrome-devtools__*",
      "mcp__astro-docs__*",
      "mcp__analytics-mcp__*"
    ],
    "deny": [
      "mcp__serena__execute_shell_command",
      "Exec(rm -rf)",
      "Exec(rm -fr)",
      "Exec(rm -r -f)",
      "Exec(rm -f -r)",
      "Exec(rm --recursive)",
      "Exec(chmod 777)",
      "Exec(chmod -R 777)",
      "Exec(dd)",
      "Exec(gh repo delete)",
      "Exec(gh auth logout)",
      "Exec(gh secret delete)",
      "Exec(gh variable delete)",
      "Exec(terraform apply)",
      "Exec(terraform destroy)",
      "Exec(terraform state push)",
      "Exec(terraform state rm)",
      "Exec(brew install)",
      "Exec(brew uninstall)",
      "Exec(brew bundle)",
      "Read(/**/.env)",
      "Read(/**/.env.*)",
      "Read(/**/.envrc)",
      "Read(~/.aws/**)",
      "Read(~/.ssh/id_*)",
      "Read(~/.gnupg/**)",
      "Read(/**/secrets/*.age)",
      "Read(/run/agenix/**)",
      "Read(~/.config/secrets/**)",
      "Read(/**/credentials.json)",
      "Read(/**/*.token)",
      "Read(/**/.*token*)",
      "Write(/**/.env*)",
      "Write(~/.ssh/**)",
      "Write(~/.aws/**)"
    ],
    "ask": [
      "Exec(git push --force)",
      "Exec(git push -f)",
      "Exec(git reset --hard)",
      "Exec(git clean)",
      "Exec(gh issue create)",
      "Exec(gh release create)",
      "Exec(gh gist create)",
      "Exec(gh pr merge)",
      "Exec(sudo)",
      "Exec(npm uninstall)",
      "Exec(npm remove)",
      "Exec(npm publish)",
      "Exec(pnpm publish)"
    ]
  }
}
